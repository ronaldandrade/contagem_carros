# ---------------------------------------------------------------- dados
# Sob data/ so vao versionados os ROTULOS (data/data2/labels/) e o exemplo
# minimo em data/exemplo/. Video e imagem ficam de fora: sao centenas de MB e
# nao pertencem a um repositorio de codigo.

# Videos originais
data/raw/

# Toda imagem sob data/ -- a regra e por extensao, e nao por pasta, para
# continuar valendo quando o dataset for reorganizado.
data/**/*.jpg
data/**/*.jpeg
data/**/*.png
data/**/*.bmp
data/**/*.mp4
data/**/*.mov
data/**/*.MOV
data/**/*.avi

# ... menos o exemplo, que precisa da imagem para o formato fazer sentido.
!data/exemplo/images/*.jpg

# Splits treino/validacao: derivados, regerados por comando a partir dos
# rotulos e das imagens.
#   data/splits1/  <- src/preparar_split.py
#   data/splits2/  <- src/preparar_split_data2.py
data/splits/
data/splits1/
data/splits2/
data/data1/splits/

# ---------------------------------------------------------------- artefatos
# Modelos e exports
models/
*.pt
*.onnx
*.engine
*.trt

# Logs de treino do Ultralytics
runs/

# Saidas de execucao: as tabelas .md e o registro de ambiente .json ficam
outputs/*.csv
outputs/*.png
!outputs/contagens.csv
